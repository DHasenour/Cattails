
//Time Range (sec)//
T_Start			0.0
T_End			10.0 

//Output Frequency//
Num_Reports		1e5
Num_Snapshots		0
Num_Checkpoints		100
Use_Logtime		0

//Grid Dimensions//
Num_R			65536
R_Min			0.0
R_Max			2e11
Log_Zoning		3 //1	//0=Uniform, 1=Log, 2=Hybrid, 3=Hybrid5050, 4=Checkpoint
Log_Radius		1e9	//Only for Hybrid options of Log_Zoning
Log_Fractn		0.75
Log_Smooth		2.0

Max_Aspect_Short        1.0   //Aspect Ratio AMR Refinement Criteria
Max_Aspect_Long         0.0   //Short/Long=0 turns off AMR 

//Numerical Parameters
CFL			0.2
PLM			1.0
Riemann_Solver		1	//0=HLL, 1=HLLC
Mesh_Motion		0	//0=Fixed, 1=By Cell, 2=Riemann Solver
Density_Floor		0.0
Pressure_Floor		1e-8 //1e-20
Absorb_Inner		0

//Reaction Network Parameters
Use_RN		1
ATOL		1e-8
RTOL		1e-8

//Gravity Parameters
Gravity_Switch		1
Gravity_G		6.67428e-8
Gravity_Pointmass	0.0 //3.02e33
Gravity_E_Mode		3   //0 = Source term, 3 = Energy term: G m/r
Gravity_Balanced	1


//RT Model Parameters
Use_RT		0
Measure_Growth		0

RT_A			1e-3 //1e-6		//1.176e-5
RT_B			2.5		//1.2
RT_C			0.2		//0.102
RT_D			2.0  		//0.0

